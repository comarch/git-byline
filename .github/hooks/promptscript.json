{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "git-byline checkpoint portable-copilot --type human --hook-input stdin # promptscript-generated:copilot-pre-edit",
        "powershell": "& 'git-byline' 'checkpoint' 'portable-copilot' '--type' 'human' '--hook-input' 'stdin' # promptscript-generated:copilot-pre-edit",
        "cwd": ".",
        "matcher": "apply_patch|create_file|edit_file|write_file|replace_string_in_file|multi_replace_string_in_file",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "git-byline checkpoint portable-copilot --type ai --hook-input stdin # promptscript-generated:copilot-post-edit",
        "powershell": "& 'git-byline' 'checkpoint' 'portable-copilot' '--type' 'ai' '--hook-input' 'stdin' # promptscript-generated:copilot-post-edit",
        "cwd": ".",
        "matcher": "apply_patch|create_file|edit_file|write_file|replace_string_in_file|multi_replace_string_in_file",
        "timeoutSec": 30
      }
    ]
  }
}
